# Copy this file to .env and replace every CHANGE_ME value locally.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BODY_BYTES=1048576
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://alibi:CHANGE_ME@localhost:5433/alibi_db
# Used only by pytest. It must never point at the development database.
TEST_DATABASE_URL=postgresql+psycopg://alibi:CHANGE_ME@localhost:5433/alibi_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=2
RABBITMQ_URL=amqp://alibi:CHANGE_ME@localhost:5672/
RABBITMQ_PASSWORD=CHANGE_ME_WITH_A_LOCAL_RABBITMQ_PASSWORD
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Staging and production load DATABASE_URL and SECRET_KEY from files in this
# directory (for example, Docker secrets), rather than from this .env file.
# SECRETS_DIR=/run/secrets
